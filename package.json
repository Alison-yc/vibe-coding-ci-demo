{
  "name": "vibe-coding-ci-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "semgrep": "semgrep --config .semgrep.yml --error src/math.ts",
    "semgrep:demo": "semgrep --config .semgrep.yml src/bad-examples.ts",
    "ci": "yarn lint && yarn test:coverage && yarn semgrep"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "~6.0.2",
    "vitest": "^3.2.4"
  }
}